# Configuration for the jpassvault sync server.
# Copy to /etc/jpassvaultserver.env and edit. Keep this file owner-only (0600):
# it contains the API secret.
#
# Required: the API secret. It must not be empty and must not be a well-known
# default, and must be at least 16 characters. The service refuses to start
# otherwise.
JPASSVAULT_SECRET=

# Listen address and port. Bind to loopback when a reverse proxy terminates TLS.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=9393

# Database location. Must be on the persistent, owner-only data directory.
# The default is jdbc:h2:file:./data/maindb.
SPRING_DATASOURCE_URL=jdbc:h2:file:/var/lib/jpassvaultserver/data/maindb

# Recommended for production: acknowledge that a trusted reverse proxy
# terminates TLS. Without any acknowledgment the server refuses to start.
APP_PROPERTIES_TLS_TERMINATED_AT_PROXY=true

# Development only: acknowledge cleartext HTTP (do not use in production).
# APP_PROPERTIES_ALLOW_PLAIN_HTTP=true

# Set to true only when the service is behind a known reverse proxy that sets
# X-Forwarded-For / Forwarded; otherwise the connection address is used.
# APP_PROPERTIES_TRUST_PROXY_HEADERS=true

# Maximum stored vault payload size in characters (default 10 MiB).
# APP_PROPERTIES_MAX_PAYLOAD_SIZE=10485760
